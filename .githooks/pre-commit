#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! git diff --quiet -- README.md; then
    printf '%s\n' \
        'README.md enthält nicht vorgemerkte Änderungen.' \
        'Bitte diese zuerst bewusst stagen oder zurücknehmen.' >&2
    exit 1
fi

"$repo_root/build/update-readme-dist.sh"

if ! git diff --quiet -- README.md; then
    git add -- README.md
fi

branch="$(git branch --show-current)"

case "$branch" in
    main|dev)
        raw_base="https://raw.githubusercontent.com/papachaotica/LSS-Tools/${branch}/"

        while IFS= read -r -d '' script; do
            [[ ( "$script" == dist/*.js || "$script" == dev/*.js ) && -f "$script" ]] || continue

            temporary_file="$(mktemp)"
            sed -E \
                "s|^([[:space:]]*//[[:space:]]*@require[[:space:]]+)http://localhost:8080/|\\1${raw_base}|" \
                "$script" > "$temporary_file"

            if ! cmp -s "$script" "$temporary_file"; then
                mv "$temporary_file" "$script"
                git add -- "$script"
            else
                rm -f "$temporary_file"
            fi
        done < <(git diff --cached --name-only --diff-filter=ACMR -z -- dev dist)

        if ! git diff --cached --quiet -- \
            lib/indexedDB.js \
            lib/api-fetch-database-handler.js; then
            version_date="$(TZ=Europe/Berlin date +%y%m%d)"

            while IFS= read -r -d '' script; do
                temporary_file="$(mktemp)"

                sed -E \
                    -e "s|^([[:space:]]*//[[:space:]]*@require[[:space:]]+)http://localhost:8080/lib/indexedDB\\.js(\\?v[^[:space:]]*)?([[:space:]]*)$|\\1${raw_base}lib/indexedDB.js?v${version_date}\\3|" \
                    -e "s|^([[:space:]]*//[[:space:]]*@require[[:space:]]+)${raw_base}lib/indexedDB\\.js(\\?v[^[:space:]]*)?([[:space:]]*)$|\\1${raw_base}lib/indexedDB.js?v${version_date}\\3|" \
                    -e "s|^([[:space:]]*//[[:space:]]*@require[[:space:]]+)http://localhost:8080/lib/api-fetch-database-handler\\.js(\\?v[^[:space:]]*)?([[:space:]]*)$|\\1${raw_base}lib/api-fetch-database-handler.js?v${version_date}\\3|" \
                    -e "s|^([[:space:]]*//[[:space:]]*@require[[:space:]]+)${raw_base}lib/api-fetch-database-handler\\.js(\\?v[^[:space:]]*)?([[:space:]]*)$|\\1${raw_base}lib/api-fetch-database-handler.js?v${version_date}\\3|" \
                    -e "/^[[:space:]]*\\/\\/[[:space:]]*@version[[:space:]]/ { s|(\\.[0-9]{6})(\\.[0-9]{4})?([[:space:]]*)$|.${version_date}\\3|; t version_date_done; s|([[:space:]]*)$|.${version_date}\\1|; :version_date_done; }" \
                    "$script" > "$temporary_file"

                if ! cmp -s "$script" "$temporary_file"; then
                    mv "$temporary_file" "$script"
                    git add -- "$script"
                else
                    rm -f "$temporary_file"
                fi
            done < <(
                rg -l -0 -e '@require[[:space:]]+https?://[^[:space:]]+/lib/indexedDB\.js([?][^[:space:]]*)?' \
                    -e '@require[[:space:]]+https?://[^[:space:]]+/lib/api-fetch-database-handler\.js([?][^[:space:]]*)?' \
                    --glob '*.js' dev dist
            )
        fi

        # Keep an optional runtime version constant aligned with the userscript header.
        while IFS= read -r -d '' script; do
            [[ -f "$script" ]] || continue

            script_version="$(sed -nE 's|^[[:space:]]*//[[:space:]]*@version[[:space:]]+([^[:space:]]+).*$|\1|p' "$script" | head -n 1)"
            [[ -n "$script_version" ]] || continue
            [[ "$script_version" =~ ^[[:alnum:]_.+-]+$ ]] || {
                printf 'Unsupported @version value in %s: %s\n' "$script" "$script_version" >&2
                exit 1
            }

            temporary_file="$(mktemp)"
            sed -E \
                "s|^([[:space:]]*const[[:space:]]+version[[:space:]]*=[[:space:]]*)['\"][^'\"]*['\"]([[:space:]]*;?[[:space:]]*)$|\\1\"${script_version}\"\\2|" \
                "$script" > "$temporary_file"

            if ! cmp -s "$script" "$temporary_file"; then
                mv "$temporary_file" "$script"
                git add -- "$script"
            else
                rm -f "$temporary_file"
            fi
        done < <(git diff --cached --name-only --diff-filter=ACMR -z -- dev dist)
        ;;
esac
